local env   = (getgenv and getgenv()) or _G
local token = {}

if env.KRHUB_LUNA then
	pcall(function() env.KRHUB_LUNA:Destroy() end)
end
env.KRHUB_TOKEN = token -- old background loops stop when this changes

local LUNA_URL = "https://raw.githubusercontent.com/Nebula-Softworks/Luna-Interface-Suite/main/source.lua"

local okLuna, Luna = pcall(function()
	return loadstring(game:HttpGet(LUNA_URL, true))()
end)
if not okLuna or not Luna then
	warn("[KRHUB] Could not load Luna Interface Suite: " .. tostring(Luna))
	return
end
env.KRHUB_LUNA = Luna

local function alive()
	return env.KRHUB_TOKEN == token
end

