local clickRayParams = RaycastParams.new()
clickRayParams.FilterType = Enum.RaycastFilterType.Exclude

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not clickTpOn then return end -- clicks on the UI are ignored
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	local cam  = workspace.CurrentCamera
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not cam or not root then return end

	local mouse = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
	clickRayParams.FilterDescendantsInstances = {char}

	local result = workspace:Raycast(ray.Origin, ray.Direction * 3000, clickRayParams)
	if result then
		char:PivotTo(CFrame.new(result.Position + Vector3.new(0, 3, 0)) * root.CFrame.Rotation)
		setStatus("Teleported", C.ok)
	else
		setStatus("Nothing to teleport to there", C.err)
	end
end)

