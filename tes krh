	----------------------------------------------------------------
	-- Teleport tab
	----------------------------------------------------------------
	local tpTab = createTab("Teleport", "my_location")

	labels.players = tpTab:CreateLabel({Text = "Players: 0", Style = 1})
	labels.match   = tpTab:CreateLabel({Text = "Type a name to teleport, spectate or ESP", Style = 1})

	tpTab:CreateInput({
		Name = "Username or display name",
		Description = nil,
		PlaceholderText = "e.g. Roblox",
		CurrentValue = "",
		Numeric = false,
		MaxCharacters = nil,
		Enter = false,
		Callback = function(text)
			if trim(text) == "" then
				currentMatch = nil
				setLabel("match", "Type a name to teleport, spectate or ESP")
			else
				local match = findPlayer(text)
				currentMatch = match
				if match then
					setLabel("match", ("Match: %s (@%s)%s"):format(
						match.DisplayName, match.Name,
						friendCache[match.UserId] and "  -  friend" or ""
					))
				else
					setLabel("match", "No matching player")
				end
			end
			updateUI()
		end,
	}, "usernameInput")

	tpTab:CreateDivider()
	makeTargetControls(tpTab, "tp", function() return currentMatch end)

	----------------------------------------------------------------
	-- Friends tab
	----------------------------------------------------------------
	local frTab = createTab("Friends", "group")

	labels.friends = frTab:CreateLabel({Text = "Friends in this server (0)", Style = 1})

	local friendByLabel = {}
	local friendDropdown = frTab:CreateDropdown({
		Name = "Friend",
		Description = "Friends who are in this server",
		Options = {"No friends in server"},
		CurrentOption = {"No friends in server"},
		MultipleOptions = false,
		SpecialType = nil,
		Callback = function(opt)
			local choice = type(opt) == "table" and opt[1] or opt
			selectedFriend = friendByLabel[choice]
			updateUI()
		end,
	}, "friendDropdown")

	frTab:CreateDivider()
	makeTargetControls(frTab, "fr", function() return selectedFriend end)

	local refreshQueued = false
	local function refreshFriends()
		local opts = {}
		table.clear(friendByLabel)

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Parent and friendCache[p.UserId] then
				local text = ("%s (@%s)"):format(p.DisplayName, p.Name)
				table.insert(opts, text)
				friendByLabel[text] = p
			end
		end

		if selectedFriend and not (selectedFriend.Parent and friendCache[selectedFriend.UserId]) then
			selectedFriend = nil
		end

		local count = #opts
		if count == 0 then opts = {"No friends in server"} end

		setLabel("friends", ("Friends in this server (%d)"):format(count))
		pcall(function() friendDropdown:Set({Options = opts}) end)
		updateUI()
	end

	-- Coalesces bursts (every checkFriend result asks for a refresh)
	scheduleFriendRefresh = function()
		if refreshQueued then return end
		refreshQueued = true
		task.delay(0.3, function()
			refreshQueued = false
			refreshFriends()
		end)
	end

	----------------------------------------------------------------
	-- Misc tab
	----------------------------------------------------------------
	local miscTab = createTab("Misc", "tune")

	miscTab:CreateSection("ESP")

	makeToggle(miscTab, "espAll", "ESP everyone", "Chams on every player in the server", false, function(on)
		if on ~= espAll then setEspAll(on) end
	end)

	makeToggle(miscTab, "espNames", "ESP names", "Name tags above ESP'd players", true, function(on)
		if on ~= espNames then setEspNames(on) end
	end)

	labels.espInfo = miscTab:CreateLabel({Text = "ESP active on 0 players", Style = 1})

	miscTab:CreateButton({
		Name = "Clear all ESP",
		Description = "ESP keeps running when you close this window",
		Callback = clearAllEsp,
	})

	miscTab:CreateSection("Camera")

	makeToggle(miscTab, "freecam", "Freecam", "WASD move, E / Q up / down, hold right mouse to look, Shift = faster, scroll = speed. Key: P", false, function(on)
		if on ~= freecamOn then
			if on then startFreecam() else stopFreecam() end
		end
		updateUI()
	end)

	miscTab:CreateSection("Anti-AFK")

	makeToggle(miscTab, "antiAfk", "Anti-AFK", "Stops you from being kicked for idling", false, function(on)
		if on ~= antiAfkOn then setAntiAfk(on) end
		updateUI()
	end)

	miscTab:CreateSection("Movement")

	local ignoreSpeedCb = false
	local speedSlider = miscTab:CreateSlider({
		Name = "Walk speed",
		Range = {SPEED_MIN, SPEED_MAX},
		Increment = 1,
		CurrentValue = SPEED_DEFAULT,
		Callback = function(value)
			if ignoreSpeedCb then return end
			setSpeed(value)
		end,
	}, "walkSpeed")

	miscTab:CreateButton({
		Name = "Reset walk speed",
		Description = nil,
		Callback = function()
			customSpeed = nil
			ignoreSpeedCb = true
			pcall(function() speedSlider:Set({CurrentValue = SPEED_DEFAULT}) end)
			task.delay(0.4, function() ignoreSpeedCb = false end)
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = SPEED_DEFAULT end
			setStatus("Walk speed reset", C.muted)
		end,
	})

	----------------------------------------------------------------
	-- Tools tab
	----------------------------------------------------------------
	local toolsTab = createTab("Tools", "build")

	toolsTab:CreateSection("Noclip")

	makeToggle(toolsTab, "noclip", "Noclip", "Walk through walls", false, function(on)
		setNoclip(on)
	end)

	toolsTab:CreateSection("Fly")

	makeToggle(toolsTab, "fly", "Fly", "WASD in the direction you look, Space / E up, Ctrl / Q down", false, function(on)
		if on ~= flyOn then
			if on then startFly() else stopFly() end
		end
		updateUI()
	end)

	toolsTab:CreateSlider({
		Name = "Fly speed",
		Range = {10, 300},
		Increment = 1,
		CurrentValue = flySpeed,
		Callback = function(value)
			flySpeed = value
		end,
	}, "flySpeed")

	toolsTab:CreateSection("Click teleport")

	makeToggle(toolsTab, "clickTp", "Click TP", "When on, left click anywhere in the world to teleport there", false, function(on)
		if on ~= clickTpOn then setClickTp(on) end
	end)

	----------------------------------------------------------------
	-- VC tab
	----------------------------------------------------------------
	local vcTab = createTab("VC", "mic")

	vcTab:CreateLabel({
		Text = "Voice Chat KRHUB adalah voice chat yang terbaik sepanjang masa, ini sangat bersejarah bagi KRH.",
