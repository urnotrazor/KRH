local currentMatch    -- player matched by the Teleport tab's input
local selectedFriend  -- player picked in the Friends tab dropdown

local toggles       = {}  -- [key] = Luna toggle element
local uiValue       = {}  -- [key] = the value the Luna element is known to show
local labels        = {}  -- [key] = Luna label element
local labelText     = {}  -- [key] = last text set on that label
local targetSyncers = {}  -- functions that re-sync the per-target toggles

local function makeToggle(tab, key, name, description, initial, onChange)
	uiValue[key] = initial
	toggles[key] = tab:CreateToggle({
		Name = name,
		Description = description,
		CurrentValue = initial,
		Callback = function(value)
			uiValue[key] = value
			onChange(value)
		end,
	}, key)
end

-- Pushes a state change into the Luna toggle (only if it differs)
local function syncToggle(key, value)
	local el = toggles[key]
	if el and uiValue[key] ~= value then
		uiValue[key] = value
		pcall(function() el:Set({CurrentValue = value}) end)
	end
end

local function setLabel(key, text)
	local el = labels[key]
	if el and labelText[key] ~= text then
		labelText[key] = text
		pcall(function() el:Set({Text = text}) end)
	end
end

local function createTab(name, icon)
	local ok, tab = pcall(function()
		return Window:CreateTab({
			Name = name,
			Icon = icon,
			ImageSource = "Material",
			ShowTitle = true,
		})
	end)
	if ok and tab then return tab end
	return Window:CreateTab({
		Name = name,
		Icon = "view_in_ar",
		ImageSource = "Material",
		ShowTitle = true,
	})
end

-- Teleport / Spectate / ESP controls for whichever player getTarget() returns
local function makeTargetControls(tab, prefix, getTarget)
	tab:CreateButton({
		Name = "Teleport",
		Description = "Teleport to the player",
		Callback = function()
			local t = getTarget()
			if t then teleportTo(t) else setStatus("Player not found", C.err) end
		end,
	})

	makeToggle(tab, prefix .. "Spec", "Spectate", "Watch the player through their camera", false, function(on)
		local t = getTarget()
		if on then
			if t then
				if spectating ~= t then startSpectating(t) end
			else
				setStatus("Player not found", C.err)
			end
		elseif spectating then
			stopSpectating()
		end
		updateUI()
	end)

	makeToggle(tab, prefix .. "Esp", "ESP", "Highlight the player through walls", false, function(on)
		local t = getTarget()
		if not t then
			setStatus("Player not found", C.err)
		elseif wantsEsp(t) ~= on then
			toggleEsp(t)
		end
		updateUI()
	end)

	table.insert(targetSyncers, function()
		local t = getTarget()
		syncToggle(prefix .. "Spec", t ~= nil and spectating == t)
		syncToggle(prefix .. "Esp", t ~= nil and t.Parent ~= nil and wantsEsp(t))
	end)
end

