local lastNote, lastNoteAt = "", 0
local function setStatus(text, kind)
	local now = os.clock()
	if text == lastNote and now - lastNoteAt < 1 then return end
	lastNote, lastNoteAt = text, now
	pcall(function()
		Luna:Notification({
			Title = "KRHUB",
			Icon = (kind == "err") and "error" or "info",
			ImageSource = "Material",
			Content = text,
		})
	end)
end

