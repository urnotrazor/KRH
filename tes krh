local function trim(s)
	return (tostring(s or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""))
end

local updateUI -- re-syncs every Luna element from the real state (set at the bottom)

--------------------------------------------------------------------
-- Friend detection
--------------------------------------------------------------------
local friendCache = {}   -- [UserId] = true/false
local scheduleFriendRefresh -- defined with the Friends tab

local function checkFriend(p)
	if p == player then return end
	task.spawn(function()
		local ok, res = pcall(function()
			return player:IsFriendsWith(p.UserId)
		end)
		friendCache[p.UserId] = (ok and res) or false
		if scheduleFriendRefresh then scheduleFriendRefresh() end
	end)
end

--------------------------------------------------------------------
-- Player lookup (exact -> prefix -> contains, on Name and DisplayName)
--------------------------------------------------------------------
local function findPlayer(query)
	query = trim(query)
	if query == "" then return nil end

	local prefix, contains
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local n, d = p.Name:lower(), p.DisplayName:lower()
			if n == query or d == query then return p end
			if not prefix and (n:sub(1, #query) == query or d:sub(1, #query) == query) then
				prefix = p
			end
			if not contains and (n:find(query, 1, true) or d:find(query, 1, true)) then
				contains = p
			end
		end
	end
	return prefix or contains
end

--------------------------------------------------------------------
-- ESP (chams) - state is independent from the UI
--------------------------------------------------------------------
local espOn      = {}     -- [UserId] = true  (individually enabled)
local espAll     = false  -- ESP for everyone
local highlights = {}     -- [UserId] = Highlight instance
local espNames   = true   -- show name tags above ESP'd players
local nameTags   = {}     -- [UserId] = BillboardGui

local function wantsEsp(p)
	return espAll or espOn[p.UserId] == true
end

local function applyHighlight(p)
	if p == player then return end

	local hl   = highlights[p.UserId]
	local char = p.Character

	if wantsEsp(p) and char and p.Parent then
		if not hl or hl.Parent ~= char then
			if hl then hl:Destroy() end
			hl = Instance.new("Highlight")
			hl.Name = "TeleportGuiESP"
			hl.FillColor = C.accent
			hl.FillTransparency = 0.5
			hl.OutlineColor = C.accent
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Adornee = char
			hl.Parent = char
			highlights[p.UserId] = hl
		end
	elseif hl then
		hl:Destroy()
		highlights[p.UserId] = nil
	end
end

local function applyNameTag(p)
	if p == player then return end

	local tag  = nameTags[p.UserId]
	local char = p.Character
	local part = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))

	if espNames and wantsEsp(p) and char and part and p.Parent then
		if not tag or tag.Parent ~= char then
			if tag then tag:Destroy() end
			tag = Instance.new("BillboardGui")
			tag.Name = "TeleportGuiESPName"
			tag.AlwaysOnTop = true
			tag.Size = UDim2.fromOffset(200, 24)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.LightInfluence = 0

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "NameLabel"
			nameLabel.BackgroundTransparency = 1
			nameLabel.Size = UDim2.fromScale(1, 1)
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.TextSize = 14
			nameLabel.TextColor3 = C.accent
			nameLabel.TextStrokeColor3 = C.black
			nameLabel.TextStrokeTransparency = 0.2
			nameLabel.Parent = tag

			tag.Adornee = part
			tag.Parent = char
			nameTags[p.UserId] = tag
		end
		tag.Adornee = part
		local nameLabel = tag:FindFirstChild("NameLabel")
		if nameLabel then nameLabel.Text = p.DisplayName end
	elseif tag then
		tag:Destroy()
		nameTags[p.UserId] = nil
	end
end

local function applyEsp(p)
	applyHighlight(p)
	applyNameTag(p)
end

local function applyEspToAll()
	for _, p in ipairs(Players:GetPlayers()) do applyEsp(p) end
end

local function countEsp()
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and wantsEsp(p) then n += 1 end
	end
	return n
end

local function toggleEsp(p)
	if not p or not p.Parent then
		setStatus("Player not found", C.err)
		return
	end
	if espAll then
		setStatus("ESP everyone is on (Misc tab)", C.muted)
		return
	end
	if espOn[p.UserId] then
		espOn[p.UserId] = nil
		applyEsp(p)
		setStatus("ESP off for " .. p.DisplayName, C.muted)
	else
		espOn[p.UserId] = true
		applyEsp(p)
		setStatus("ESP on for " .. p.DisplayName, C.ok)
	end
	if updateUI then updateUI() end
end

local function setEspAll(state)
	espAll = state
	applyEspToAll()
	if updateUI then updateUI() end
	setStatus(state and "ESP on for everyone" or "ESP off for everyone", state and C.ok or C.muted)
end

local function setEspNames(state)
	espNames = state
	applyEspToAll()
	if updateUI then updateUI() end
	setStatus(state and "ESP names shown" or "ESP names hidden", state and C.ok or C.muted)
end

local function clearAllEsp()
	espAll = false
	table.clear(espOn)
	applyEspToAll()
	if updateUI then updateUI() end
	setStatus("All ESP cleared", C.muted)
end

local function setupEspPlayer(p)
	if p == player then return end
	p.CharacterAdded:Connect(function()
		task.defer(applyEsp, p)
	end)
	applyEsp(p)
end

Players.PlayerAdded:Connect(function(p)
	setupEspPlayer(p)
	if updateUI then updateUI() end
end)
Players.PlayerRemoving:Connect(function(p)
	local hl = highlights[p.UserId]
	if hl then hl:Destroy() end
	highlights[p.UserId] = nil
	local tag = nameTags[p.UserId]
	if tag then tag:Destroy() end
	nameTags[p.UserId] = nil
	espOn[p.UserId] = nil
	task.defer(function()
		if updateUI then updateUI() end
	end)
end)
for _, p in ipairs(Players:GetPlayers()) do setupEspPlayer(p) end

-- Safety net: re-applies ESP once a second in case the game removed a highlight
task.spawn(function()
	while alive() do
		task.wait(1)
		applyEspToAll()
	end
end)

--------------------------------------------------------------------
-- Teleport logic
--------------------------------------------------------------------
local busy = false

local function teleportTo(target)
	if busy then return end
	busy = true

	if not target or not target.Parent then
		setStatus("Player not found", C.err)
		busy = false
		return
	end

	local myChar    = player.Character
	local myRoot    = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local theirChar = target.Character
	local theirRoot = theirChar and theirChar:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		setStatus("Your character isn't loaded", C.err)
		busy = false
		return
	end
	if not theirRoot then
		setStatus(target.DisplayName .. " has no character", C.err)
		busy = false
		return
	end

	-- Land just behind the target
	myChar:PivotTo(theirRoot.CFrame * CFrame.new(0, 0, 3))

	setStatus("Teleported to " .. target.DisplayName, C.ok)
	task.delay(0.6, function()
		busy = false
	end)
end

--------------------------------------------------------------------
-- Spectate logic
--------------------------------------------------------------------
local spectating            -- the Player being watched, or nil
local specConns = {}
local stopFreecam           -- defined in the freecam section

local function stopSpectating(silent)
	for _, c in ipairs(specConns) do c:Disconnect() end
	table.clear(specConns)
	spectating = nil

	local cam = workspace.CurrentCamera
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if cam and hum then cam.CameraSubject = hum end

	if updateUI then updateUI() end
	if not silent then setStatus("Stopped spectating", C.muted) end
end

local function startSpectating(target)
	if not target or not target.Parent then
		setStatus("Player not found", C.err)
		return
	end
	if stopFreecam then stopFreecam(true) end
	if spectating then stopSpectating(true) end
	spectating = target

	local function attach(char)
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
		if hum and spectating == target then
			workspace.CurrentCamera.CameraSubject = hum
		end
	end

	task.spawn(attach, target.Character)

	-- Follow them through respawns
	table.insert(specConns, target.CharacterAdded:Connect(function(c)
		task.spawn(attach, c)
	end))
	-- Stop if they leave
	table.insert(specConns, Players.PlayerRemoving:Connect(function(p)
		if p == target then
			stopSpectating(true)
			setStatus(target.DisplayName .. " left the server", C.muted)
		end
	end))
	-- Stop if you respawn (camera resets to you anyway)
	table.insert(specConns, player.CharacterAdded:Connect(function()
		stopSpectating(true)
	end))

	if updateUI then updateUI() end
	setStatus("Spectating " .. target.DisplayName, C.ok)
end

--------------------------------------------------------------------
-- Anti-AFK
--------------------------------------------------------------------
local antiAfkOn     = false
local antiAfkConn   = nil
local antiAfkStored = {}   -- other Idled connections we paused: {conn = ..., enabled = true}
local antiAfkMode   = nil  -- "VirtualUser" or "VIM"
local antiAfkVIM    = nil

local function disableAntiAfk()
	if antiAfkConn then
		pcall(function()
			antiAfkConn:Disconnect()
		end)
		antiAfkConn = nil
	end

	for _, item in ipairs(antiAfkStored) do
		if item.conn and item.enabled then
			pcall(function()
				item.conn:Enable()
			end)
		end
	end

	table.clear(antiAfkStored)
	antiAfkMode = nil
	antiAfkVIM = nil
end

local function enableAntiAfk()
	if antiAfkConn then
		return true
	end

	-- Pause any other Idled connections (restored in disableAntiAfk)
	if typeof(getconnections) == "function" then
		local ok, conns = pcall(getconnections, player.Idled)
		if ok and type(conns) == "table" then
			for _, c in ipairs(conns) do
				if c.Enabled ~= false then
					local paused = pcall(function() c:Disable() end)
					if paused then
						table.insert(antiAfkStored, {conn = c, enabled = true})
					end
				end
			end
		end
	end

	-- Pick a method: VirtualUser first, VirtualInputManager as fallback
	local okVU = pcall(function() VirtualUser:CaptureController() end)
	if okVU then
		antiAfkMode = "VirtualUser"
	else
		local okVIM, vim = pcall(function()
			return game:GetService("VirtualInputManager")
		end)
		if okVIM and vim then
			antiAfkMode = "VIM"
			antiAfkVIM = vim
		else
			disableAntiAfk()
			return false
		end
	end

	antiAfkConn = player.Idled:Connect(function()
		if antiAfkMode == "VirtualUser" then
			pcall(function()
				local cam = workspace.CurrentCamera
				local cf = cam and cam.CFrame or CFrame.new()
				VirtualUser:CaptureController()
				VirtualUser:Button2Down(Vector2.zero, cf)
				task.wait(1)
				VirtualUser:Button2Up(Vector2.zero, cf)
			end)
		elseif antiAfkMode == "VIM" and antiAfkVIM then
			pcall(function()
				antiAfkVIM:SendMouseButtonEvent(0, 0, 1, true, game, 0)
				task.wait(0.1)
				antiAfkVIM:SendMouseButtonEvent(0, 0, 1, false, game, 0)
			end)
		end
	end)

	return true
end

local function setAntiAfk(state)
	if state then
		if enableAntiAfk() then
			antiAfkOn = true
			setStatus("Anti-AFK on", C.ok)
		else
			antiAfkOn = false
			setStatus("Anti-AFK unavailable here", C.err)
		end
	else
		disableAntiAfk()
		antiAfkOn = false
		setStatus("Anti-AFK off", C.muted)
	end
	if updateUI then updateUI() end
end

--------------------------------------------------------------------
-- Freecam
--------------------------------------------------------------------
local FC_MIN, FC_MAX = 5, 300
local fcSpeed = 50
local freecamOn = false
local fcConn
local fcPos = Vector3.zero
local fcPitch, fcYaw = 0, 0

-- The default control module is switched off during freecam so your
-- character stands still while the camera flies around.
local function getControls()
	local ok, controls = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 3)
		return require(module):GetControls()
	end)
	return ok and controls or nil
end

local function startFreecam()
	if freecamOn then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	if spectating then stopSpectating(true) end

	freecamOn = true
	local rx, ry = cam.CFrame:ToOrientation()
	fcPitch, fcYaw = math.deg(rx), math.deg(ry)
	fcPos = cam.CFrame.Position
	cam.CameraType = Enum.CameraType.Scriptable

	local controls = getControls()
	if controls then controls:Disable() end

	fcConn = RunService.RenderStepped:Connect(function(dt)
		local c = workspace.CurrentCamera
		if not c then return end
		if c.CameraType ~= Enum.CameraType.Scriptable then
			c.CameraType = Enum.CameraType.Scriptable
		end

		local typing  = UserInputService:GetFocusedTextBox() ~= nil
		local looking = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		UserInputService.MouseBehavior = looking
			and Enum.MouseBehavior.LockCurrentPosition
			or Enum.MouseBehavior.Default

		if looking then
			local d = UserInputService:GetMouseDelta()
			fcYaw -= d.X * 0.25
			fcPitch = math.clamp(fcPitch - d.Y * 0.25, -85, 85)
		end

		local rot = CFrame.fromOrientation(math.rad(fcPitch), math.rad(fcYaw), 0)

		if not typing then
			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
			if move.Magnitude > 0 then move = move.Unit end

			local vertical = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.E) then vertical += 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) then vertical -= 1 end

			local boost = (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) and 3 or 1
			local velocity = rot:VectorToWorldSpace(move) + Vector3.new(0, vertical, 0)
			fcPos += velocity * fcSpeed * boost * dt
		end

		c.CFrame = CFrame.new(fcPos) * rot
	end)

	if updateUI then updateUI() end
	setStatus("Freecam on", C.ok)
end

stopFreecam = function(silent)
	if not freecamOn then return end
	freecamOn = false
	if fcConn then fcConn:Disconnect() fcConn = nil end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then cam.CameraSubject = hum end
	end

	local controls = getControls()
	if controls then controls:Enable() end

	if updateUI then updateUI() end
	if not silent then setStatus("Freecam off", C.muted) end
end

local function toggleFreecam()
	if freecamOn then stopFreecam() else startFreecam() end
end

-- Mouse wheel changes the freecam speed
UserInputService.InputChanged:Connect(function(input, processed)
	if freecamOn and not processed and input.UserInputType == Enum.UserInputType.MouseWheel then
		local factor = input.Position.Z > 0 and 1.15 or (1 / 1.15)
		fcSpeed = math.clamp(fcSpeed * factor, FC_MIN, FC_MAX)
		setStatus("Freecam speed: " .. math.floor(fcSpeed + 0.5), C.muted)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.P then
		toggleFreecam()
	end
end)

