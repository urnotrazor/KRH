-- Noclip
--------------------------------------------------------------------
local noclipOn = false
local noclipConn
local noclipTouched = setmetatable({}, {__mode = "k"})

local function setNoclip(state)
	if state == noclipOn then return end
	noclipOn = state

	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					noclipTouched[part] = true
					part.CanCollide = false
				end
			end
		end)
	else
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
		for part in pairs(noclipTouched) do
			if part.Parent then part.CanCollide = true end
		end
		table.clear(noclipTouched)
	end

	if updateUI then updateUI() end
	setStatus(state and "Noclip on" or "Noclip off", state and C.ok or C.muted)
end

