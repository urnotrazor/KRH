-- Online friends (same game / other games) + server hop
--------------------------------------------------------------------
local onlineFriends = {}      -- latest GetFriendsOnline result
local lastFetch = 0           -- os.clock() of the last successful fetch
local fetching = false
local REFRESH_COOLDOWN = 10   -- seconds between manual refreshes
local MAX_JOIN_TRIES = 20     -- how many times to retry a full server
local JOIN_RETRY_DELAY = 6    -- seconds between retries

local joinTarget = nil        -- UserId currently being joined
local joinToken = 0           -- bumps to cancel old retry loops
local joinButtons = {}        -- [UserId] = JOIN button (for the STOP label)

local function isInGame(f)
	return f.PlaceId ~= nil and f.GameId ~= nil and (f.LocationType == 4 or f.LocationType == 1)
end

local function setJoinLabels()
	for userId, btn in pairs(joinButtons) do
		if btn.Parent then
			setToggleStyle(btn, joinTarget == userId, "STOP", "JOIN")
		end
	end
end

local function stopJoining(silent)
	joinToken += 1
	joinTarget = nil
	setJoinLabels()
	if not silent then setStatus("Join cancelled", C.muted) end
end

local function findOnline(userId)
	for _, f in ipairs(onlineFriends) do
		if f.VisitorId == userId then return f end
	end
end

-- Join a friend's exact server. If it's full (or we're flooding the
-- teleport service) it keeps retrying until a slot opens or you press STOP.
local function joinFriend(f)
	if joinTarget == f.VisitorId then
		stopJoining()
		return
	end

	joinToken += 1
	local myToken = joinToken
	joinTarget = f.VisitorId
	setJoinLabels()

	task.spawn(function()
		local tries = 0
		local current = f
		while joinToken == myToken do
			tries += 1
			setStatus(("Joining %s (try %d/%d)"):format(f.DisplayName, tries, MAX_JOIN_TRIES), C.ok)

			local failedResult
			local conn
			conn = TeleportService.TeleportInitFailed:Connect(function(_, result)
				failedResult = result
			end)

			local ok, err = pcall(function()
				TeleportService:TeleportToPlaceInstance(current.PlaceId, current.GameId, player)
			end)

			if not ok then
				conn:Disconnect()
				stopJoining(true)
				setStatus("Join failed: " .. tostring(err), C.err)
				return
			end

			-- wait a few seconds to see whether the teleport actually failed
			local waited = 0
			while waited < 4 and not failedResult and joinToken == myToken do
				task.wait(0.25)
				waited += 0.25
			end
			conn:Disconnect()
			if joinToken ~= myToken then return end
			if not failedResult then
				return -- teleport is happening, nothing else to do
			end

			local retryable = failedResult == Enum.TeleportResult.GameFull
				or failedResult == Enum.TeleportResult.Flooded
			if not retryable then
				stopJoining(true)
				if failedResult == Enum.TeleportResult.Unauthorized then
					setStatus("Can't join: not allowed (private or restricted)", C.err)
				elseif failedResult == Enum.TeleportResult.GameEnded then
					setStatus("That server no longer exists", C.err)
				else
					setStatus("Join failed: " .. tostring(failedResult.Name), C.err)
				end
				return
			end

			if tries >= MAX_JOIN_TRIES then
				stopJoining(true)
				setStatus("Server stayed full, gave up", C.err)
				return
			end

			-- server full: wait, then look up where the friend is now
			for i = JOIN_RETRY_DELAY, 1, -1 do
				if joinToken ~= myToken then return end
				setStatus(
					("%s - retry in %ds (%d/%d)"):format(
						failedResult == Enum.TeleportResult.GameFull and "Server full" or "Slow down",
						i, tries, MAX_JOIN_TRIES),
					C.muted
				)
				task.wait(1)
			end
			if joinToken ~= myToken then return end

			if fetchOnlineFriends then fetchOnlineFriends(true) end
			local fresh = findOnline(f.VisitorId)
			if not fresh or not isInGame(fresh) then
				stopJoining(true)
				setStatus(f.DisplayName .. " left that game", C.err)
				return
			end
			current = fresh
		end
	end)
end

