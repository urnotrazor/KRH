-- Fullbright: ONE toggle. Turns on bright daylight and removes fog,
-- shadows and post effects together. Values are re-applied every frame
-- so the game can't switch them back; turning it off restores
-- whatever the game had before.
--------------------------------------------------------------------
local fullbrightOn = false
local setFullbright
do
	local Lighting = game:GetService("Lighting")

	local FORCED = {
		Brightness     = 2,
		ClockTime      = 14,
		Ambient        = Color3.fromRGB(170, 170, 170),
		OutdoorAmbient = Color3.fromRGB(170, 170, 170),
		FogStart       = 1e9,
		FogEnd         = 1e9,
		GlobalShadows  = false,
	}
	local EFFECTS = {
		BlurEffect = true, ColorCorrectionEffect = true, SunRaysEffect = true,
		BloomEffect = true, DepthOfFieldEffect = true,
	}

	-- originals of everything we change (strong references on purpose,
	-- so every single one can be put back)
	local origProps = {}   -- [prop] = value
	local savedInst = {}   -- [Atmosphere / effect] = {original values}
	local conn, acc = nil, 0

	local function applyProps()
		for prop, value in pairs(FORCED) do
			if Lighting[prop] ~= value then Lighting[prop] = value end
		end
	end

	-- looks through everything inside Lighting and the camera (including folders)
	local function applyInstances()
		local roots = {Lighting}
		if workspace.CurrentCamera then table.insert(roots, workspace.CurrentCamera) end
		for _, root in ipairs(roots) do
			for _, c in ipairs(root:GetDescendants()) do
				if c:IsA("Atmosphere") then
					if not savedInst[c] then savedInst[c] = {Density = c.Density, Haze = c.Haze} end
					if c.Density ~= 0 then c.Density = 0 end
					if c.Haze ~= 0 then c.Haze = 0 end
				elseif EFFECTS[c.ClassName] then
					if not savedInst[c] then savedInst[c] = {Enabled = c.Enabled} end
					if c.Enabled then c.Enabled = false end
				end
			end
		end
	end

	local function putBack(props, insts)
		for prop, value in pairs(props) do
			pcall(function() Lighting[prop] = value end)
		end
		for c, v in pairs(insts) do
			pcall(function()
				if v.Enabled ~= nil then
					c.Enabled = v.Enabled
				else
					c.Density = v.Density
					c.Haze = v.Haze
				end
			end)
		end
	end

	setFullbright = function(state)
		state = state and true or false
		if state == fullbrightOn then return end
		fullbrightOn = state

		if state then
			for prop in pairs(FORCED) do origProps[prop] = Lighting[prop] end
			applyProps()
			applyInstances()
			conn = RunService.Heartbeat:Connect(function(dt)
				if not gui.Parent then
					-- the script was run again: put the lighting back and stop
					setFullbright(false)
					return
				end
				applyProps()
				acc += dt
				if acc >= 0.5 then
					acc = 0
					applyInstances()
				end
			end)
		else
			if conn then conn:Disconnect() conn = nil end
			-- take the saved originals, then put them back right now and once more
			-- a moment later in case the game's own scripts changed things in between
			local props, insts = origProps, savedInst
			origProps, savedInst = {}, {}
			putBack(props, insts)
			task.delay(0.3, function()
				if not fullbrightOn then putBack(props, insts) end
			end)
		end

		if updateUI then updateUI() end
		if gui.Parent then
			setStatus(state and "Fullbright on" or "Fullbright off", state and C.ok or C.muted)
		end
	end
end

