rebuildOnlineLists = function()
	for _, list in ipairs({sameList, otherList}) do
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("Frame") then child:Destroy() end
		end
	end
	table.clear(joinButtons)

	local sameN, otherN = 0, 0
	for _, f in ipairs(onlineFriends) do
		if isInGame(f) and f.GameId ~= game.JobId then
			if f.PlaceId == game.PlaceId then
				sameN += 1
				makeOnlineRow(sameList, f, sameN, true)
