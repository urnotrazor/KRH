-- Per-player save file (needs an executor with writefile / readfile).
-- SAVED: key binds, the Keybinds switch, every switch and setting on the ESP tab,
-- and the Freecam and Anti-AFK switches.
-- NOT saved: Fullbright, Walk speed, Fly, Noclip, Click teleport.
local SAVE_FILE = "KRHUB_settings_" .. player.UserId .. ".json"
KB.http = game:GetService("HttpService")
KB.restore = {}        -- switches to turn back on once the window is ready
KB.started = false
KB.lastJson = ""

function KB.canSave()
	return typeof(writefile) == "function"
end
function KB.canLoad()
	return typeof(readfile) == "function"
end
KB.report = function() end   -- the Settings tab replaces this to show the save status

-- what gets written to the file (colors become {r, g, b} numbers)
function KB.snapshot()
	local binds = {}
	for _, def in ipairs(KB.defs) do
		local c = KB.binds[def.id]
		binds[def.id] = c and c.Name or false
	end
	local box = {}
	for k, v in pairs(boxCfg) do
		if typeof(v) == "Color3" then
			box[k] = {math.round(v.R * 255), math.round(v.G * 255), math.round(v.B * 255)}
		else
			box[k] = v
		end
	end
	return {
		v = 1,
		commandKey = cmdKey.Name,
		keybindsOn = KB.on,
		binds = binds,
		esp = {all = espAll, names = espNames, box = box},
		freecam = freecamOn,
		antiAfk = antiAfkOn,
	}
end

-- writes the file when something changed (or always when force = true)
function KB.flush(force)
	if not KB.started then return end
	if not KB.canSave() then return end
	local ok, json = pcall(function() return KB.http:JSONEncode(KB.snapshot()) end)
	if not ok then
		warn("KRHUB save failed (encode): " .. tostring(json))
		KB.report("Save failed: " .. tostring(json), false)
		return
	end
	if force or json ~= KB.lastJson then
		local wok, werr = pcall(writefile, SAVE_FILE, json)
		if wok then
			KB.lastJson = json
			KB.report("Saved at " .. os.date("%H:%M:%S") .. " (" .. SAVE_FILE .. ")", true)
		else
			warn("KRHUB save failed (write): " .. tostring(werr))
			KB.report("Save failed: " .. tostring(werr), false)
		end
	end
end

-- read the file now, before the pages are built, so every switch starts right
do
	pcall(function()
		if not KB.canLoad() then return end
		-- this account's file first, then the old shared file once so your keys carry over
		local raw
		for _, path in ipairs({SAVE_FILE, SETTINGS_FILE}) do
			local okr, text = pcall(readfile, path)
			if okr and type(text) == "string" and text ~= "" then
				raw = text
				break
			end
		end
		if not raw then return end
		local data = KB.http:JSONDecode(raw)
		if type(data) ~= "table" then return end

		local function code(name)
			local ok, c = pcall(function() return Enum.KeyCode[name] end)
			return ok and c or nil
		end
		if type(data.commandKey) == "string" and code(data.commandKey) then cmdKey = code(data.commandKey) end
		if type(data.keybindsOn) == "boolean" then KB.on = data.keybindsOn end
		if type(data.binds) == "table" then
			for _, def in ipairs(KB.defs) do
				local v = data.binds[def.id]
				if v == false then
					KB.binds[def.id] = false
				elseif type(v) == "string" and code(v) then
					KB.binds[def.id] = code(v)
				end
			end
		end

		if type(data.antiAfk) == "boolean" then KB.restore.antiAfk = data.antiAfk end
		KB.restore.freecam = data.freecam == true

		local esp = data.esp
		if type(esp) == "table" then
			if type(esp.names) == "boolean" then espNames = esp.names end
			KB.restore.espAll = esp.all == true

			local s = esp.box
			if type(s) == "table" then
				for _, k in ipairs({"enabled", "outline", "displayName", "distance", "meters", "health",
					"tracers", "textSame", "teamCheck", "teamColor", "rainbow", "chams"}) do
					if type(s[k]) == "boolean" then boxCfg[k] = s[k] end
				end
				local function num(k, lo, hi)
					if type(s[k]) == "number" then boxCfg[k] = math.clamp(math.round(s[k]), lo, hi) end
				end
				num("thickness", 1, 6)
				num("fill", 0, 100)
				num("tracerThickness", 1, 6)
				num("textSize", 8, 24)
				num("maxDist", 50, 5000)
				if s.style == "Box" or s.style == "Corners" then boxCfg.style = s.style end
				if s.tracerFrom == "Player" or s.tracerFrom == "Bottom" or s.tracerFrom == "Center" then
					boxCfg.tracerFrom = s.tracerFrom
				end
				for _, k in ipairs({"color", "textColor"}) do
					local c = s[k]
					if type(c) == "table" and type(c[1]) == "number" and type(c[2]) == "number" and type(c[3]) == "number" then
						boxCfg[k] = Color3.fromRGB(
							math.clamp(c[1], 0, 255), math.clamp(c[2], 0, 255), math.clamp(c[3], 0, 255))
					end
				end
			end
		end
	end)
end

-- called once when the window is ready: turn the saved switches back on,
-- then start saving automatically (checks once a second, writes only on change)
function KB.start()
	local r = KB.restore
	if r.espAll then setEspAll(true) end
	if r.antiAfk ~= nil and r.antiAfk ~= antiAfkOn then setAntiAfk(r.antiAfk) end
	if r.freecam then startFreecam() end

	KB.started = true
	if not KB.canSave() then
		KB.report("Can't save: your executor has no writefile function.", false)
	end
	KB.flush(true)
	task.spawn(function()
		while gui.Parent do
			task.wait(1)
			KB.flush(false)
		end
	end)
end

