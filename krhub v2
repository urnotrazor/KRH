		local p = Players:GetPlayerByUserId(userId)
		setToggleStyle(btn, p ~= nil and wantsEsp(p), "ESP", "ESP")
	end

	-- Misc tab
	if allInfo then
		local n = countEsp()
		allInfo.Text = ("ESP active on %d player%s"):format(n, n == 1 and "" or "s")
	end

	-- banner summary pill (hidden when nothing is active)
	local parts = {}
	if spectating then table.insert(parts, "watching " .. spectating.DisplayName) end
	if freecamOn then table.insert(parts, "freecam") end
	if espAll then
		table.insert(parts, "ESP: all")
