--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamMedium
	l.TextColor3 = C.text
	l.TextSize = 14
	for k, v in pairs(props) do l[k] = v end
	l.Parent = parent
	return l
end

-- Next LayoutOrder inside a container (keeps list order = creation order).
-- FIX: a nil container used to crash here ("attempt to index nil with
-- 'GetAttribute'"); it now just returns 0.
local function nextOrder(container)
	if not container then return 0 end
	local n = (container:GetAttribute("n") or 0) + 1
	container:SetAttribute("n", n)
	return n
end

-- Hover / press feedback by color only (no scaling, so nothing gets
-- clipped by scrolling frames). The button's resting color lives in the
-- "base" attribute, so toggle styles can change it and hover still works.
local function makeInteractive(btn)
	local function target()
		local base = btn:GetAttribute("base") or btn.BackgroundColor3
		if btn:GetAttribute("down") then
			return base:Lerp(C.black, 0.3)
		elseif btn:GetAttribute("hover") then
			return base:Lerp(C.accent, 0.09)
		end
		return base
	end
	local function refresh()
		tween(btn, 0.12, {BackgroundColor3 = target()})
	end
	btn.MouseEnter:Connect(function()
		btn:SetAttribute("hover", true)
		refresh()
	end)
	btn.MouseLeave:Connect(function()
		btn:SetAttribute("hover", false)
		btn:SetAttribute("down", false)
		refresh()
	end)
	btn.MouseButton1Down:Connect(function()
		btn:SetAttribute("down", true)
		refresh()
	end)
	btn.MouseButton1Up:Connect(function()
		btn:SetAttribute("down", false)
		refresh()
	end)
	btn:GetAttributeChangedSignal("base"):Connect(refresh)
end

-- Generic button. style = "primary" (gold) or "ghost" (dark, outlined)
local function makeButton(parent, text, style, textSize)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = textSize or 12
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	if style == "primary" then
		b.BackgroundColor3 = C.gold
		b.TextColor3 = C.text
	else
		b.BackgroundColor3 = C.field
		b.TextColor3 = C.text
	end
	b.Parent = parent
	corner(b, 7)
	local s = stroke(b, style == "primary" and C.goldLine or C.cardStroke, 1, 0)
	s.Name = "Stroke"
	b:SetAttribute("base", b.BackgroundColor3)
	makeInteractive(b)
	return b
end

-- Toggle look for ghost buttons (gold when active)
local function setToggleStyle(btn, active, activeText, idleText)
	if not btn then return end
	btn.Text = active and activeText or idleText
	btn:SetAttribute("base", active and C.goldBg or C.field)
	tween(btn, 0.2, {TextColor3 = active and C.mint or C.text})
	local s = btn:FindFirstChild("Stroke")
	if s then tween(s, 0.2, {Color = active and C.mint or C.cardStroke}) end
end

local function trim(s)
	return (tostring(s or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Segmented control with a sliding highlight (used for the OFF / ON switches)
local function makeSegmented(parent, options, size, selColors)
	local n = #options
	local api = {}
	local current = 1

	local frame = Instance.new("Frame")
	frame.Size = size
	frame.BackgroundColor3 = C.field
	frame.BorderSizePixel = 0
	frame.Parent = parent
	corner(frame, 7)
	stroke(frame, C.cardStroke, 1, 0)

	local inner = Instance.new("Frame")
	inner.BackgroundTransparency = 1
	inner.Position = UDim2.fromOffset(2, 2)
	inner.Size = UDim2.new(1, -4, 1, -4)
	inner.Parent = frame

	local hl = Instance.new("Frame")
	hl.Size = UDim2.new(1 / n, 0, 1, 0)
	hl.BackgroundColor3 = C.segSel
	hl.BorderSizePixel = 0
	hl.Parent = inner
	corner(hl, 5)

	local buttons = {}

	local function set(idx, instant)
		current = idx
		local pos = UDim2.new((idx - 1) / n, 0, 0, 0)
		if instant then
			hl.Position = pos
		else
			tween(hl, 0.22, {Position = pos}, Enum.EasingStyle.Quint)
		end
		for i, b in ipairs(buttons) do
			local col = (i == idx) and (selColors[i] or C.text) or C.muted
			if instant then
				b.TextColor3 = col
			else
				tween(b, 0.2, {TextColor3 = col})
			end
		end
	end

	for i, text in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1 / n, 0, 1, 0)
		b.Position = UDim2.new((i - 1) / n, 0, 0, 0)
		b.BackgroundTransparency = 1
		b.Text = text
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.TextColor3 = C.muted
		b.AutoButtonColor = false
		b.ZIndex = 2
		b.Parent = inner
		buttons[i] = b
		b.MouseButton1Click:Connect(function()
			-- flip mode: clicking anywhere on the switch flips it
			local idx = api.flip and ((current == 1) and 2 or 1) or i
			if current == idx then return end
			set(idx)
			if api.onSelect then api.onSelect(idx) end
		end)
	end

	api.flip = true
	api.frame = frame
	api.set = set
	set(1, true)
	return api
end

