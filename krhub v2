			for _, c in ipairs(COMMANDS) do
				if c.name:sub(1, #q) == q then
					table.insert(list, {full = c.name .. " ", label = c.name, desc = c.usage})
				end
			end
			if #list == 0 then
				for _, c in ipairs(COMMANDS) do
					if c.name:find(q, 1, true) then
						table.insert(list, {full = c.name .. " ", label = c.name, desc = c.usage})
					end
				end
			end
			return list
		end

		local cmd = findCommand(text:sub(1, sp - 1):lower())
		if not cmd then return list end
		local q = text:sub(sp + 1):lower()

		if cmd.suggest then
			local cands = cmd.suggest()
			local seen = {}
			local function take(c)
				if not seen[c] then
					seen[c] = true
					table.insert(list, {full = cmd.name .. " " .. c.text, label = c.text, desc = c.desc or ""})
				end
			end
			for _, c in ipairs(cands) do
				if q == "" or c.text:lower():sub(1, #q) == q or (c.alt and c.alt:lower():sub(1, #q) == q) then take(c) end
			end
			if q ~= "" then
				for _, c in ipairs(cands) do
					if c.text:lower():find(q, 1, true) or (c.alt and c.alt:lower():find(q, 1, true)) then take(c) end
				end
			end
		elseif q == "" then
			-- no completions for this command, just remind the usage
			table.insert(list, {full = nil, label = cmd.usage, desc = ""})
		end
		return list
	end

	local function render()
		local n = #suggList
		-- keep the selected row inside the visible window
		if selIdx < viewStart then viewStart = selIdx end
		if selIdx > viewStart + MAX_SUGG - 1 then viewStart = selIdx - MAX_SUGG + 1 end

		local shown = math.min(n, MAX_SUGG)
		for i = 1, MAX_SUGG do
			local row = rows[i]
			local item = suggList[viewStart + i - 1]
			if i <= shown and item then
				local selected = (viewStart + i - 1 == selIdx)
				row.frame.Visible = true
				row.name.Text = item.label
				row.desc.Text = item.desc
				tween(row.frame, 0.08, {BackgroundTransparency = selected and 0 or 1})
				tween(row.name, 0.08, {TextColor3 = selected and C.text or C.muted})
			else
				row.frame.Visible = false
			end
		end

		local h = shown > 0 and (shown * ROW_H + 8) or 0
		sugg.Visible = shown > 0 and not cmdBusy
		tween(sugg, 0.1, {Size = UDim2.new(1, 0, 0, h)})

		-- inline ghost text
		local typed = box.Text
		local sel = suggList[selIdx]
		if sel and sel.full and #sel.full > #typed and sel.full:lower():sub(1, #typed) == typed:lower() then
			ghost.Text = typed .. sel.full:sub(#typed + 1)
		else
			ghost.Text = ""
		end
	end

	local function refresh()
		suggList = computeSuggestions(box.Text)
		selIdx, viewStart = 1, 1
		render()
	end

	-- Open / close -----------------------------------------------------
	local function closeBar()
		if not cmdOpen then return end
		cmdOpen = false
		if box:IsFocused() then box:ReleaseFocus() end
		local tw = tween(root, 0.16, {
			Position = UDim2.new(0.5, 0, 1, -72 + 10),
			GroupTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tw.Completed:Connect(function()
			if not cmdOpen then root.Visible = false end
		end)
	end

	local function openBar()
		if cmdOpen or not ready then return end
		cmdOpen, cmdBusy = true, false
		openedAt = os.clock()

		box.Visible, hint.Visible = true, true
		feedback.Visible = false
		box.Text, ghost.Text = "", ""
		suggList = {}
		sugg.Visible = false
		sugg.Size = UDim2.new(1, 0, 0, 0)

		root.Visible = true
		root.Position = LOW
		root.GroupTransparency = 1
		tween(root, 0.26, {Position = REST, GroupTransparency = 0}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

		task.wait() -- let the key press finish first so ";" isn't typed into the box
		if cmdOpen then box:CaptureFocus() end
	end

	toggleCommandBar = function()
		if cmdOpen then
			if not cmdBusy then closeBar() end
		else
			task.spawn(openBar)
		end
	end

	-- Running -----------------------------------------------------
	local function showResult(ok, msg)
		cmdBusy = true
		box.Visible, ghost.Text, hint.Visible = false, "", false
		sugg.Visible = false
		feedback.Text = msg
		feedback.TextColor3 = ok and C.mint or C.err
		feedback.Visible = true
		task.delay(ok and 0.9 or 1.7, function()
			if cmdBusy then
				cmdBusy = false
				closeBar()
			end
		end)
	end

	local function runText(raw)
		local text = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return false, "Type a command first" end
		local name, arg = text:match("^(%S+)%s*(.-)$")
		local cmd = resolveCommand(name:lower())
		if not cmd then return false, "Unknown command: " .. name end
		local ok, a, b = pcall(cmd.run, arg or "")
		if not ok then
			warn("Command error: " .. tostring(a))
			return false, "Command failed"
		end
		if a == nil then a = true end
		return a, b or ""
	end

	-- Events -------------------------------------------------------
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local t = box.Text
		local cleaned = t:gsub("\t", ""):gsub("^%s+", "")
		if cleaned ~= t then
			box.Text = cleaned
			box.CursorPosition = #cleaned + 1
			return
		end

		-- the key that opened the bar can leak into the box as a character
		local ch = ""
		local okc, str = pcall(function() return UserInputService:GetStringForKeyCode(cmdKey) end)
		if okc and type(str) == "string" and #str == 1 then ch = str end
		if ch ~= "" and cmdOpen and os.clock() - openedAt < 0.25 and t:lower() == ch:lower() then
			box.Text = ""
			return
		end

		refresh()
	end)

	box.FocusLost:Connect(function(enterPressed)
		if not cmdOpen or cmdBusy then return end
		if enterPressed then
			local ok, msg = runText(box.Text)
			showResult(ok, msg)
		else
			closeBar()
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not cmdOpen or cmdBusy or not box:IsFocused() then return end
		local n = #suggList
		if input.KeyCode == Enum.KeyCode.Tab then
			local s = suggList[selIdx]
			if s and s.full then
				box.Text = s.full
				box.CursorPosition = #box.Text + 1
			end
		elseif input.KeyCode == Enum.KeyCode.Down and n > 0 then
			selIdx = selIdx % n + 1
			render()
		elseif input.KeyCode == Enum.KeyCode.Up and n > 0 then
			selIdx = (selIdx - 2) % n + 1
			render()
		end
	end)
end)()

--------------------------------------------------------------------
-- Dragging (title bar + the slim handle at the bottom)
--------------------------------------------------------------------
local dragging, dragStart, startPos

local function makeDraggable(handle)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
end

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

makeDraggable(titleBar)

