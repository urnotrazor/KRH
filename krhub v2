-- force = true skips the cooldown (used by the retry loop)
fetchOnlineFriends = function(force)
	if fetching then return false end
	if not force and os.clock() - lastFetch < REFRESH_COOLDOWN then return false end
	fetching = true

	local ok, result = pcall(function()
		return player:GetFriendsOnline(200)
	end)
	fetching = false

	if ok and type(result) == "table" then
		onlineFriends = result
		lastFetch = os.clock()
		rebuildOnlineLists()
		return true
	end
	setStatus("Couldn't load friend activity", C.err)
	return false
end

