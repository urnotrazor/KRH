--------------------------------------------------------------------
-- Box ESP: box / corners, ONE name, distance, health bar, and a line
-- from you to the other player (old-school CS style)
--------------------------------------------------------------------
do
	local old = playerGui:FindFirstChild("KRHUBBoxESP")
	if old then old:Destroy() end

	local espGui = Instance.new("ScreenGui")
	espGui.Name = "KRHUBBoxESP"
	espGui.ResetOnSpawn = false
	espGui.IgnoreGuiInset = true      -- so WorldToViewportPoint lines up exactly
	espGui.DisplayOrder = -1          -- under the KRHUB window and the game's own UI
	espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	espGui.Parent = playerGui

	local function newFrame(parent, z)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.ZIndex = z or 1
		f.Parent = parent
		return f
	end

	local function newText(parent)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.GothamBold
		t.TextStrokeTransparency = 0.2
		t.TextStrokeColor3 = Color3.new(0, 0, 0)
		t.Size = UDim2.fromOffset(220, 16)
		t.ZIndex = 4
		t.Parent = parent
		return t
	end

	local objs = {}   -- [Player] = element table

	local function makeObj()
		local o = {}
		o.holder = Instance.new("Frame")
		o.holder.BackgroundTransparency = 1
		o.holder.Size = UDim2.fromScale(1, 1)
		o.holder.Visible = false
		o.holder.Parent = espGui

		o.outline = newFrame(o.holder, 1)
		o.outline.BackgroundTransparency = 1
		o.outlineStroke = Instance.new("UIStroke")
		o.outlineStroke.Color = Color3.new(0, 0, 0)
		o.outlineStroke.Parent = o.outline

		o.box = newFrame(o.holder, 2)
		o.boxStroke = Instance.new("UIStroke")
		o.boxStroke.Parent = o.box

		o.lines = {}
		for i = 1, 8 do o.lines[i] = newFrame(o.holder, 2) end

		o.tracer = newFrame(o.holder, 1)
		o.tracer.AnchorPoint = Vector2.new(0.5, 0.5)

		o.hpBack = newFrame(o.holder, 2)
		o.hpBack.BackgroundColor3 = Color3.new(0, 0, 0)
		o.hpFill = newFrame(o.hpBack, 3)
		o.hpFill.AnchorPoint = Vector2.new(0, 1)

		o.name = newText(o.holder)
		o.name.AnchorPoint = Vector2.new(0.5, 1)
		o.dist = newText(o.holder)
		o.dist.AnchorPoint = Vector2.new(0.5, 0)
		return o
	end

	local function destroyObj(p)
		local o = objs[p]
		if o then o.holder:Destroy() objs[p] = nil end
	end

	Players.PlayerRemoving:Connect(destroyObj)

	local function px(n) return math.floor(n + 0.5) end

	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not gui.Parent then      -- script was re-run: clean up
			conn:Disconnect()
			espGui:Destroy()
			return
		end

		local cam = workspace.CurrentCamera
		if not cam then return end
		local cfg = boxCfg
		local vp = cam.ViewportSize
		local camPos = cam.CFrame.Position
		local rainbow = Color3.fromHSV(tick() % 5 / 5, 1, 1)

		-- where the lines start: your own character on screen (or bottom / center)
		local ox, oy = vp.X / 2, vp.Y
		if cfg.tracerFrom == "Center" then
			ox, oy = vp.X / 2, vp.Y / 2
		elseif cfg.tracerFrom == "Player" then
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local v = cam:WorldToViewportPoint(myRoot.Position)
				if v.Z > 0 then ox, oy = v.X, v.Y end
			end
		end

		for _, p in ipairs(Players:GetPlayers()) do
			if p == player then continue end

			local char = p.Character
			local hrp  = char and char:FindFirstChild("HumanoidRootPart")
			local hum  = char and char:FindFirstChildOfClass("Humanoid")

			local ok = cfg.enabled and wantsEsp(p) and hrp and hum and hum.Health > 0
			if ok and cfg.teamCheck and p.Team ~= nil and p.Team == player.Team then ok = false end

			local dist, top, bottom
			if ok then
				dist = (camPos - hrp.Position).Magnitude
				if dist > cfg.maxDist then
					ok = false
				else
					top    = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.7, 0))
					bottom = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))
					if top.Z <= 0 or bottom.Z <= 0 then ok = false end
				end
			end

			local o = objs[p]
			if not ok then
				if o then o.holder.Visible = false end
				continue
			end
			if not o then o = makeObj() objs[p] = o end
			o.holder.Visible = true

			-- geometry
			local h  = math.max(bottom.Y - top.Y, 4)
			local w  = h * 0.6
			local cx = top.X
			local x  = px(cx - w / 2)
			local y  = px(top.Y)
			local W, H = px(w), px(h)
			local t  = cfg.thickness

			-- color
			local color = cfg.color
			if cfg.rainbow then
				color = rainbow
			elseif cfg.teamColor and p.Team then
				color = p.TeamColor.Color
			end

			-- box / corners
			local boxStyle = cfg.style == "Box"
			o.box.Visible = boxStyle
			o.outline.Visible = boxStyle and cfg.outline
			if boxStyle then
				o.box.Position = UDim2.fromOffset(x, y)
				o.box.Size = UDim2.fromOffset(W, H)
				o.box.BackgroundColor3 = color
				o.box.BackgroundTransparency = 1 - cfg.fill / 100
				o.boxStroke.Color = color
				o.boxStroke.Thickness = t
				o.outline.Position = o.box.Position
				o.outline.Size = o.box.Size
				o.outlineStroke.Thickness = t + 2
			end

			local L = px(math.min(W, H) * 0.28)
			local defs = {
				{x, y, L, t},               {x, y, t, L},                       -- top left
				{x + W - L, y, L, t},       {x + W - t, y, t, L},               -- top right
				{x, y + H - t, L, t},       {x, y + H - L, t, L},               -- bottom left
				{x + W - L, y + H - t, L, t}, {x + W - t, y + H - L, t, L},     -- bottom right
			}
			for i, line in ipairs(o.lines) do
				line.Visible = not boxStyle
				if not boxStyle then
					local d = defs[i]
					line.Position = UDim2.fromOffset(d[1], d[2])
					line.Size = UDim2.fromOffset(d[3], d[4])
					line.BackgroundColor3 = color
				end
			end

			-- health bar
			o.hpBack.Visible = cfg.health
			if cfg.health then
				local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				o.hpBack.Position = UDim2.fromOffset(x - 6, y - 1)
				o.hpBack.Size = UDim2.fromOffset(4, H + 2)
				o.hpFill.Position = UDim2.new(0, 1, 1, -1)
				o.hpFill.Size = UDim2.new(1, -2, frac, -2 * frac)
				o.hpFill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 1, 1)
			end

			-- text (the ONE name tag; the "ESP names" switch controls it)
			local tc = cfg.textSame and color or cfg.textColor
			o.name.Visible = espNames
			if espNames then
				o.name.Text = cfg.displayName and p.DisplayName or p.Name
				o.name.TextSize = cfg.textSize
				o.name.TextColor3 = tc
				o.name.Position = UDim2.fromOffset(px(cx), y - 3)
			end
			o.dist.Visible = cfg.distance
			if cfg.distance then
				local shown = cfg.meters and dist * 0.28 or dist
				o.dist.Text = ("[%d %s]"):format(math.floor(shown + 0.5), cfg.meters and "m" or "studs")
				o.dist.TextSize = math.max(cfg.textSize - 1, 8)
				o.dist.TextColor3 = tc
				o.dist.Position = UDim2.fromOffset(px(cx), y + H + 3)
			end

			-- line between you and the other player
			o.tracer.Visible = cfg.tracers
			if cfg.tracers then
				local x1, y1 = ox, oy
				local x2, y2 = cx, (cfg.tracerFrom == "Player") and (y + H / 2) or (y + H)
				local dx, dy = x2 - x1, y2 - y1
				o.tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), cfg.tracerThickness)
				o.tracer.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
				o.tracer.Rotation = math.deg(math.atan2(dy, dx))
				o.tracer.BackgroundColor3 = color
			end
		end
	end)
end

