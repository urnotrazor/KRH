--------------------------------------------------------------------
-- Resizing (drag the grip in the bottom right corner)
--------------------------------------------------------------------
do
	local MIN_W, MIN_H, MAX_W, MAX_H = 580, 380, 1000, 720

	local grip = Instance.new("TextButton")
	grip.Name = "ResizeGrip"
	grip.AnchorPoint = Vector2.new(1, 0.5)
	grip.Position = UDim2.new(1, -6, 0.5, 0)
	grip.Size = UDim2.fromOffset(24, 24)
	grip.BackgroundTransparency = 1
	grip.Text = ""
	grip.AutoButtonColor = false
	grip.ZIndex = 5
	grip.Parent = footer

	-- three little dots in a corner shape
	local dots = {}
	for _, d in ipairs({{16, 16}, {10, 16}, {16, 10}, {4, 16}, {10, 10}, {16, 4}}) do
		local dot = Instance.new("Frame")
		dot.Position = UDim2.fromOffset(d[1], d[2])
		dot.Size = UDim2.fromOffset(3, 3)
		dot.BackgroundColor3 = C.faint
		dot.BorderSizePixel = 0
		dot.Parent = grip
		corner(dot, 2)
		table.insert(dots, dot)
	end
	local function tintDots(col)
		for _, d in ipairs(dots) do tween(d, 0.12, {BackgroundColor3 = col}) end
	end
	grip.MouseEnter:Connect(function() tintDots(C.mint) end)
	grip.MouseLeave:Connect(function() tintDots(C.faint) end)

	local resizing, startMouse, startW, startH, startPos
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startMouse = input.Position
			startW, startH = fullSize.X.Offset, fullSize.Y.Offset
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if resizing and not minimized
			and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
			local scale = math.max(mainScale.Scale, 0.1)
			local d = (input.Position - startMouse) / scale
			local w = math.clamp(startW + d.X, MIN_W, MAX_W)
			local h = math.clamp(startH + d.Y, MIN_H, MAX_H)
			fullSize = UDim2.fromOffset(w, h)
			main.Size = fullSize
			-- main is centered on its position, so shift by half the change
			-- to keep the top-left corner where it is
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + (w - startW) / 2,
				startPos.Y.Scale, startPos.Y.Offset + (h - startH) / 2
			)
		end
	end)
end

--------------------------------------------------------------------
-- Loading bar, then the panel pops in
--------------------------------------------------------------------
task.spawn(function()
	local box = Instance.new("CanvasGroup")
	box.Name = "Loader"
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.fromScale(0.5, 0.5)
	box.Size = UDim2.fromOffset(300, 92)
	box.BackgroundColor3 = C.card
	box.BorderSizePixel = 0
	box.GroupTransparency = 1
	box.Parent = gui
	corner(box, 10)
	stroke(box, C.cardStroke, 1, 0)

	local boxScale = Instance.new("UIScale")
	boxScale.Scale = 0.92
	boxScale.Parent = box

	label(box, {
		Text = "KRHUB",
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 22),
	})
	local stage = label(box, {
		Text = "Starting",
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(20, 36),
		Size = UDim2.new(1, -90, 0, 16),
	})
	local pct = label(box, {
		Text = "0%",
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = C.mint,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -70, 0, 36),
		Size = UDim2.fromOffset(50, 16),
	})

	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(20, 64)
	track.Size = UDim2.new(1, -40, 0, 4)
	track.BackgroundColor3 = C.field
	track.BorderSizePixel = 0
	track.Parent = box
	corner(track, 2)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = C.mint
	fill.BorderSizePixel = 0
	fill.Parent = track
	corner(fill, 2)

	-- one NumberValue drives the bar and the percentage so they stay in sync
	local progress = Instance.new("NumberValue")
	progress.Changed:Connect(function(v)
		fill.Size = UDim2.fromScale(v, 1)
		pct.Text = math.floor(v * 100 + 0.5) .. "%"
	end)

	tween(box, 0.25, {GroupTransparency = 0})
	tween(boxScale, 0.3, {Scale = 1})
	task.wait(0.25)

	local steps = {
		{"Loading interface", 0.35, 0.8},
		{"Checking friends",  0.75, 0.9},
		{"Almost ready",      1.0, 0.8},
	}
	for i, step in ipairs(steps) do
		stage.Text = step[1]
		if i == 2 then
			task.spawn(function() pcall(fetchOnlineFriends, true) end)
		end
		local tw = tween(progress, step[3], {Value = step[2]}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tw.Completed:Wait()
	end

	task.wait(0.15)
	local out = tween(box, 0.25, {GroupTransparency = 1})
	tween(boxScale, 0.25, {Scale = 0.94})
	out.Completed:Wait()
	box:Destroy()
	progress:Destroy()

	ready = true
	visible = true
	main.Visible = true
	updateUI()
	tween(mainScale, 0.5, {Scale = 1}, Enum.EasingStyle.Back)
end)
