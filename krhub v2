--------------------------------------------------------------------
local TAB_INDEX = {Normal = 1, Friends = 2, All = 3, ESP = 4, Settings = 5}
local TAB_PAGES = {Normal = normalPage, Friends = friendsPage, All = allPage, ESP = espPage, Settings = settingsPage}

local function paintTabs(name)
	for key, btn in pairs(TAB_BUTTONS) do
		local active = (key == name)
		tween(btn, 0.2, {
			BackgroundTransparency = active and 0 or 1,
			TextColor3 = active and C.mint or C.muted,
		})
		local s = btn:FindFirstChild("Stroke")
		if s then tween(s, 0.2, {Transparency = active and 0 or 1}) end
	end
end
paintTabs(currentTab)

local function switchTab(name)
	if name == currentTab then return end
	local fromIdx, toIdx = TAB_INDEX[currentTab], TAB_INDEX[name]
	local hidePage, showPage = TAB_PAGES[currentTab], TAB_PAGES[name]
	currentTab = name

	paintTabs(name)

	hidePage.Visible = false
	showPage.Position = UDim2.fromOffset(toIdx > fromIdx and 54 or -26, 12)
	showPage.Visible = true
	tween(showPage, 0.35, {Position = PAGE_POS})

	if name == "Friends" then
		refreshFriends()
		if os.clock() - lastFetch >= 20 then task.spawn(fetchOnlineFriends, true) end
	end
	updateUI()
end

for key, btn in pairs(TAB_BUTTONS) do
	btn.MouseButton1Click:Connect(function() switchTab(key) end)
end

