--------------------------------------------------------------------
-- Minimize / close / toggle
--------------------------------------------------------------------
local minimized = false

local function setMinimized(state)
	minimized = state
	minBtn.Text = state and "+" or "–"
	if state then
		content.Visible = false
		tween(main, 0.35, {Size = MINI_SIZE}, Enum.EasingStyle.Back)
	else
		tween(main, 0.4, {Size = FULL_SIZE}, Enum.EasingStyle.Back)
		task.delay(0.15, function()
			if not minimized then content.Visible = true end
		end)
	end
end

minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)

local visible = true
local function setVisible(state)
	visible = state
	if state then
		main.Visible = true
		tween(mainScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
		-- Re-sync every button with the real ESP / spectate state, so the
		-- window always matches what is actually happening in the game.
		updateUI()
	else
		local tw = tween(mainScale, 0.25, {Scale = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tw.Completed:Connect(function()
			if not visible then main.Visible = false end
		end)
		-- Note: ESP is intentionally NOT touched here. It keeps running.
	end
end

closeBtn.MouseButton1Click:Connect(function()
	setVisible(false) -- just hides it; press K to bring it back
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.K or input.KeyCode == Enum.KeyCode.RightShift then
		setVisible(not visible)
	end
end)

--------------------------------------------------------------------
-- Dragging (by title bar)
--------------------------------------------------------------------
do
	local dragging, dragStart, startPos

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

