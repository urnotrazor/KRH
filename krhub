--------------------------------------------------------------------
-- Tab switching
--------------------------------------------------------------------
local TAB_INDEX = {Normal = 1, Friends = 2, All = 3}
local TAB_BUTTONS = {Normal = normalTab, Friends = friendsTab, All = allTab}
local TAB_PAGES = {Normal = normalPage, Friends = friendsPage, All = allPage}
local currentTab = "Normal"

local function switchTab(name)
	if name == currentTab then return end
	local fromIdx, toIdx = TAB_INDEX[currentTab], TAB_INDEX[name]
	local hidePage, showPage = TAB_PAGES[currentTab], TAB_PAGES[name]
	currentTab = name

	tween(indicator, 0.35, {
		Position = UDim2.new((toIdx - 1) / 3, 3, 0, 3)
	}, Enum.EasingStyle.Back)

	for tabName, btn in pairs(TAB_BUTTONS) do
		tween(btn, 0.2, {TextColor3 = (tabName == name) and C.black or C.muted})
	end

	hidePage.Visible = false
	showPage.Position = UDim2.fromOffset(toIdx > fromIdx and 48 or -12, 50)
	showPage.Visible = true
	tween(showPage, 0.35, {Position = PAGE_POS})

	if name == "Friends" then refreshFriends() end
	updateUI()
end

