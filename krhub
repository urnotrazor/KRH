updateUI = function()
	-- player card
	local onCardSpec = spectating ~= nil and spectating == currentMatch
	setToggleStyle(cardSpecBtn, onCardSpec, "STOP", "SPECTATE")
	local onCardEsp = currentMatch ~= nil and currentMatch.Parent ~= nil and wantsEsp(currentMatch)
	setToggleStyle(cardEspBtn, onCardEsp, "ESP ON", "ESP")

	-- friend rows
	for userId, btn in pairs(rowSpecButtons) do
		local active = spectating ~= nil and spectating.UserId == userId
		setToggleStyle(btn, active, "STOP", "SPECTATE")
	end
	for userId, btn in pairs(rowEspButtons) do
		local p = Players:GetPlayerByUserId(userId)
		setToggleStyle(btn, p ~= nil and wantsEsp(p), "ESP", "ESP")
	end

	-- All tab
	setToggleStyle(allEspBtn, espAll, "ESP EVERYONE: ON", "ESP EVERYONE: OFF")
	setToggleStyle(namesBtn, espNames, "NAMES: ON", "NAMES: OFF")
	if allInfo then
		local n = countEsp()
		allInfo.Text = ("ESP active on %d player%s"):format(n, n == 1 and "" or "s")
	end

	-- title bar summary
	local parts = {}
	if spectating then table.insert(parts, "watching " .. spectating.DisplayName) end
	if espAll then
		table.insert(parts, "ESP: all")
	else
		local n = countEsp()
		if n > 0 then table.insert(parts, "ESP: " .. n) end
	end
	titleSub.Text = table.concat(parts, "  |  ")
end

refreshFriends = function()
	for _, child in ipairs(friendList:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	table.clear(rowSpecButtons)
	table.clear(rowEspButtons)

	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Parent and friendCache[p.UserId] then
			count += 1
			makeFriendRow(p, count)
		end
	end

	emptyLabel.Visible = (count == 0)
	friendsHeader.Text = ("Friends in this server (%d)"):format(count)
	friendsTab.Text = count > 0 and ("Friends (%d)"):format(count) or "Friends"
	updateUI()
end

